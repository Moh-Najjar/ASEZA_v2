{
  "info": {
    "name": "Aseza Admin Portal",
    "description": "Complete API collection for the Aseza Admin Portal — NestJS backend running on http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT access token — filled automatically by the Login request's Tests script."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "POST /auth/login — validates admin credentials and returns a signed JWT. The Tests script saves the token into the collection variable `token` automatically."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "POST /auth/logout — blacklists the current Bearer token in Redis (no response body, 204)."
          }
        }
      ]
    },
    {
      "name": "Admin / Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1", "description": "1-based page number" },
                { "key": "pageSize", "value": "20", "description": "Results per page" },
                { "key": "search", "value": "", "description": "Free-text filter on username/email", "disabled": true },
                { "key": "isActive", "value": "true", "description": "Filter by active status (true/false)", "disabled": true }
              ]
            },
            "description": "GET /admin/users — paginated list of users with optional search and isActive filter."
          }
        },
        {
          "name": "Get User Roles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/roles",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "1", "roles"]
            },
            "description": "GET /admin/users/:userId/roles — lists all role assignments for a specific user."
          }
        },
        {
          "name": "Assign Role to User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/roles",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "1", "roles"]
            },
            "description": "POST /admin/users/:userId/roles — assigns a role to a user (idempotent)."
          }
        },
        {
          "name": "Remove Role from User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/roles/1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "1", "roles", "1"]
            },
            "description": "DELETE /admin/users/:userId/roles/:roleId — removes a role assignment from a user (204)."
          }
        },
        {
          "name": "Assign Directorate to User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"directorateId\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/directorate",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "1", "directorate"]
            },
            "description": "PUT /admin/users/:userId/directorate — assigns or unassigns a directorate. Send { \"directorateId\": null } to unassign."
          }
        },
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/roles",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "roles"]
            },
            "description": "GET /admin/roles — returns all available roles for dropdown population."
          }
        }
      ]
    },
